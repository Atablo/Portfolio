
---
import ExperienceItem from "./ExperienceItem.astro"

const EXPERIENCE=[
{   
    "initDate":"October 2024",
    "endDate":"May 2025",
    "title": "Web Developer focused on accessibility and educational platforms",
    "description":"Developed and maintained accessible websites such as weadapta.org and escuelaac.com using CMS platforms, primarily WordPress with Elementor. Additionally, created content-driven pages for the University of Castilla-La Mancha's EAPA and ECAAT degree programs. My role also involved customizing augmentative and alternative communication (AAC) tools like Grid 3, Proloquo2Go, and Verbo by Eneso, as well as adapting assistive hardware to meet diverse user needs.",
    "company": "La Fábrica de Palabras",
    
},
{   
    "initDate":"April 2024",
    "endDate":"June 2024",
    "title": "Internship as a Web Applications Developer in the R&D Department.",
    "description":"I participated in the development of a computer-aided maintenance management system (CMMS) using Angular and APIs, improving the efficiency of the system by implementing PrimeNG components and enhancing the user experience.",
    "company": "LM Automatismos",
    
}
]
---
<ol class="relative border-s border-amber-600 dark:border-amber-200 ml-3">
    {EXPERIENCE.map(experience =>
        <li class="mb-10 ms-4">
            <ExperienceItem {...experience}></ExperienceItem>
        </li>
     ) }                  
    
</ol>

